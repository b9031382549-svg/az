# ── Production env template ──────────────────────────────────────────────────
# Copy to .env next to docker-compose.prod.yml and fill in the blanks. NEVER commit
# the real .env. The values are the ones production runs with (2026-10-19): the code
# defaults differ in places, so a key left out changes how lines get classified.
# Blank = a secret or a host-specific value; each one says what goes there.
# An install on the customer's own GPU (no Nebius, OpenAI-compatible embeddings):
# .env.onprem.example and DEPLOY.md instead.

APP_NAME="eInvoice AI"
APP_ORGANIZATION="Demo Organization"   # shown under the user's name in the sidebar
APP_ENV=production
APP_DEBUG=false
APP_KEY=                         # php artisan key:generate --show
APP_URL=                         # the address users open, e.g. https://classifier.example.az
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs go to container stdout (docker compose logs) — no storage volume needed.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Postgres + pgvector — service name on the compose network is `pgsql`.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=                     # a strong password (the db container takes it too)
# Read-only role the AI chat runs its SQL as (created by a migration, grants: nlsql:grant).
DB_RO_USERNAME=app_ro
DB_RO_PASSWORD=                  # another strong password

# Sessions / cache live in Postgres; the queue runs on Redis (Horizon).
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
# Must exceed the longest job timeout (SearchResolveJob = 300 s — web search + reasoning)
# so a slow job is never re-dispatched while still running (no duplicate paid calls).
REDIS_QUEUE_RETRY_AFTER=360
MAIL_MAILER=log

# ── Embeddings (Ollama, internal compose service, never published) ──────────
OLLAMA_URL=http://ollama:11434
# bge-ft-v3 = bge-m3 fine-tuned on our lines; created in Ollama from its GGUF (not in git).
# The catalog vectors must come from the same model (data:embed-catalog --refresh after a change).
OLLAMA_EMBED_MODEL=bge-ft-v3
EMBED_DIMENSIONS=1024

# ── LLM providers (OpenAI-compatible) ───────────────────────────────────────
# OpenRouter: the web-search step of the conflict resolver (":online" models) and the
# stages set to an OpenRouter model id.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=              # secret
OPENROUTER_MODEL=openai/gpt-4o-mini
# Nebius Token Factory: a stage whose model starts with "nebius:", and the fallback for
# gpu:base / gpu:tuned while no GPU server is serving.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=                  # secret
NEBIUS_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# ── Model per stage ─────────────────────────────────────────────────────────
# gpu:base  = Llama-3.3-70B-Instruct on a GPU server running vLLM (registered on the app's
#             /gpu-servers page), gpu:tuned = the same model + our LoRA "xif".
# Any stage takes an OpenRouter id instead, or "nebius:<model>" for Token Factory.
CLASSIFY_DIRECT_MODEL=gpu:tuned
CLASSIFY_EXPAND_MODEL=gpu:base
OPENROUTER_CLASSIFY_MODEL=gpu:base
CLASSIFY_BROKER_MODEL=gpu:base
CLASSIFY_BROKER_BRIEF_MODEL=gpu:base
CLASSIFY_BROKER_FACT_MODEL=gpu:base
CLASSIFY_TRANSLATE_MODEL=gpu:base
# Code defaults, kept as they are: the AI chat (NL->SQL) and the web-search resolver.
#NLSQL_MODEL=gpu:base
#CLASSIFY_SEARCH_RESOLVER_MODEL=deepseek/deepseek-v4-flash:online

# ── Classification pipeline ─────────────────────────────────────────────────
# Mechanisms: vector retrieval + Direct (the LLM names the heading); consensus = Direct's
# answer among the vector's top headings. The broker mechanism exists but is off.
CLASSIFY_MECHANISMS=vector,direct
CLASSIFY_DIRECT_GRANULARITY=heading
CLASSIFY_BROKER_ANSWER_GRANULARITY=heading
CLASSIFY_TWO_TIER=false
# Retrieval: vector first, heading fusion, customs precedents as an extra vector source.
CLASSIFY_VECTOR_FIRST=true
CLASSIFY_VF_HEADING_DIVERSE=true
CLASSIFY_VF_LEXICAL=6
CLASSIFY_VF_SHOW_SIM=true
CLASSIFY_HEADING_FUSION=true
CLASSIFY_HEADING_CODES=1
CLASSIFY_PRECEDENTS_ENABLED=true
CLASSIFY_PRECEDENTS_TOP_K=40
CLASSIFY_PRECEDENTS_PER_HEADING=2
# Conflicts (no consensus): ensemble resolver, then the web search; unsure → human review.
CLASSIFY_FLOW_ENRICH_BRIEF=false
CLASSIFY_FLOW_VECTOR_MULTI_QUERY=false
CLASSIFY_FLOW_ENSEMBLE_RESOLVER=true
CLASSIFY_FLOW_SHADOW=false
CLASSIFY_SEARCH_RESOLVER_ENABLED=true
CLASSIFY_SEARCH_RESOLVER_GROUNDED_MIN_CONF=0.90
CLASSIFY_ADJUDICATOR_ENABLED=true
CLASSIFY_ADJUDICATOR_MODE=active
# Memory: answers the pipeline agreed on (and human / grounded-search ones) are written to
# the answer cache, so the same name is answered from memory next time.
CLASSIFY_MEMORY_PROMOTION=true
CLASSIFY_MEMORY_PROMOTION_SHADOW=false
CLASSIFY_MEMORY_PROMOTE_CONFIRMED=true
CLASSIFY_MEMORY_PROMOTE_GROUNDED_SEARCH=true

# Sorter (good / service / trash) — the `sorter` container; model files in
# /opt/az-assets/sorter-v2 (not in git). Defaults are the prod values: leave unset.
# Empty URL = sorter off (the pipeline runs without it).
#CLASSIFY_SORTER_URL=http://sorter:8000
# p(trash) at which the sorter settles a line as trash: the precision-98 % point of that
# model file (its meta.json). Change only together with the model.
#CLASSIFY_SORTER_TRASH_THRESHOLD=0.99747
#CLASSIFY_SORTER_TIMEOUT=120
# The web search also sets aside lines that name no product (a person, a firm, a document…)
# when the sorter's p(trash) is at least MIN_SORTER. On by default; false switches it off.
#CLASSIFY_SEARCH_TRASH_CHECK=true
#CLASSIFY_SEARCH_TRASH_MIN_SORTER=0.2

# ── GPU servers rented from the app (Nebius AI Cloud) ───────────────────────
# Only for renting / retraining / tearing down from the /gpu-servers page; a GPU server
# run by hand needs none of this. The nebius CLI + its config + the SSH key are mounted
# from /opt/az-secrets.
NEBIUS_GOLDEN_SNAPSHOT_ID=       # disk snapshot the GPU VMs boot from
GPU_SSH_KEY=                     # path inside the worker to the private key for the GPU VMs
GPU_SSH_PUBKEY=                  # path to its public key
GPU_ADAPTER_DIR=/opt/az-assets/adapters
GPU_PLATFORM=gpu-h100-sxm
GPU_MAX_MODEL_LEN=8192
GPU_MEM_UTIL=0.95
GPU_TRAIN_MAX_EXAMPLES=0
