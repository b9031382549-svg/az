# ── On-premise env template (the customer's own GPU) ─────────────────────────────
# Every setting the service reads, for an install where the LLM runs on your own GPU
# (vLLM), the embeddings on your own server, and only the web search goes out (OpenRouter).
# Plain environment variables: no .env file is needed if your platform injects them.
# Values = what our production runs with; blank = a secret or a host-specific value.
# Secrets: APP_KEY, DB_PASSWORD, DB_RO_PASSWORD, LLM_API_KEY, EMBED_API_KEY, OPENROUTER_API_KEY.
# Step by step: DEPLOY.md.

APP_NAME="eInvoice AI"
APP_ORGANIZATION=                # shown under the user's name in the sidebar
APP_ENV=production
APP_DEBUG=false
APP_KEY=                         # php artisan key:generate --show
APP_URL=                         # the address users open, e.g. https://classifier.example.az
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs go to stdout.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL 16 with the pgvector extension (>= 0.5, for HNSW).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=
# Read-only role the AI chat runs its SQL as (created by a migration, grants: nlsql:grant).
DB_RO_USERNAME=app_ro
DB_RO_PASSWORD=

# Sessions / cache live in Postgres; the queue runs on Redis (Horizon).
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=null
# Must exceed the longest job timeout (the web-search job, 300 s).
REDIS_QUEUE_RETRY_AFTER=360
MAIL_MAILER=log

# ── LLM: your GPU server (vLLM, OpenAI-compatible) ──────────────────────────────
LLM_BASE_URL=                    # including /v1, e.g. http://vllm:8000/v1
LLM_API_KEY=                     # vLLM --api-key; leave empty if it has none
LLM_BASE_MODEL=base              # the --served-model-name of the stock model
LLM_TUNED_MODEL=xif              # the --lora-modules name of our adapter
# The GPU is required: a classification job whose model server cannot answer waits and
# retries (30 s doubling to every 10 min, up to HOURS) instead of going on without it.
# Keep both timeouts under 120 s (the job's own), or a hung server counts as an error.
CLASSIFY_WAIT_FOR_MODELS=true
CLASSIFY_WAIT_FOR_MODELS_HOURS=24
CLASSIFY_DIRECT_TIMEOUT=90
EMBED_TIMEOUT=60
# No GPU renting from the app (Nebius): the /gpu-servers page and its job are off.
GPU_PROVISIONING=false

# Which model each stage uses. gpu:base = LLM_BASE_MODEL, gpu:tuned = LLM_TUNED_MODEL.
CLASSIFY_DIRECT_MODEL=gpu:tuned
CLASSIFY_EXPAND_MODEL=gpu:base
CLASSIFY_BROKER_MODEL=gpu:base
CLASSIFY_BROKER_BRIEF_MODEL=gpu:base
CLASSIFY_BROKER_FACT_MODEL=gpu:base
CLASSIFY_TRANSLATE_MODEL=gpu:base
NLSQL_MODEL=gpu:base
OPENROUTER_CLASSIFY_MODEL=gpu:base
OPENROUTER_CLASSIFY_TIER1_MODEL=gpu:base
# A call that names no model of its own stays on your GPU too.
OPENROUTER_MODEL=gpu:base

# ── Embeddings: bge-ft-v3, 1024 dims, cosine ───────────────────────────────────
# openai = any OpenAI-compatible POST /v1/embeddings (vLLM, TEI, llama.cpp server,
# Ollama's /v1); ollama = an Ollama server with the model created from GGUF + Modelfile.
EMBED_DRIVER=openai
EMBED_BASE_URL=                  # including /v1, e.g. http://embedder:8000/v1
EMBED_API_KEY=                   # leave empty if the server has no key
EMBED_MODEL=bge-ft-v3            # the name the server serves the model under
EMBED_DIMENSIONS=1024
# With EMBED_DRIVER=ollama instead:
#OLLAMA_URL=http://ollama:11434
#OLLAMA_EMBED_MODEL=bge-ft-v3

# ── Web search: OpenRouter (the only outbound access, https://openrouter.ai) ────
# Resolves the lines where Direct and the vector search disagree: understand the line
# with web search, vote over a shortlist, then search the web for what the vote can't
# settle. Only the item name and public catalog texts are sent. Models: the code
# defaults, as we measured them.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=              # secret
#CLASSIFY_FLOW_ENSEMBLE_UNDERSTAND_MODEL=deepseek/deepseek-v4-flash:online
#CLASSIFY_FLOW_ENSEMBLE_MODEL=deepseek/deepseek-v4-flash
#CLASSIFY_SEARCH_RESOLVER_MODEL=deepseek/deepseek-v4-flash:online

# ── Classification pipeline (as in our production) ─────────────────────────────
CLASSIFY_MECHANISMS=vector,direct
CLASSIFY_DIRECT_GRANULARITY=heading
CLASSIFY_BROKER_ANSWER_GRANULARITY=heading
CLASSIFY_TWO_TIER=false
CLASSIFY_VECTOR_FIRST=true
CLASSIFY_VF_HEADING_DIVERSE=true
CLASSIFY_VF_LEXICAL=6
CLASSIFY_VF_SHOW_SIM=true
CLASSIFY_HEADING_FUSION=true
CLASSIFY_HEADING_CODES=1
CLASSIFY_PRECEDENTS_ENABLED=true
CLASSIFY_PRECEDENTS_TOP_K=40
CLASSIFY_PRECEDENTS_PER_HEADING=2
CLASSIFY_FLOW_ENRICH_BRIEF=false
CLASSIFY_FLOW_VECTOR_MULTI_QUERY=false
CLASSIFY_FLOW_ENSEMBLE_RESOLVER=true
CLASSIFY_FLOW_SHADOW=false
CLASSIFY_SEARCH_RESOLVER_ENABLED=true
CLASSIFY_SEARCH_RESOLVER_GROUNDED_MIN_CONF=0.90
CLASSIFY_ADJUDICATOR_ENABLED=false
# Memory: answers the pipeline agreed on (and human / grounded-search ones) are written to
# the answer cache, so the same name is answered from memory next time.
CLASSIFY_MEMORY_PROMOTION=true
CLASSIFY_MEMORY_PROMOTION_SHADOW=false
CLASSIFY_MEMORY_PROMOTE_CONFIRMED=true
CLASSIFY_MEMORY_PROMOTE_GROUNDED_SEARCH=true

# Sorter (good / service / trash): the `sorter` container with the sorter-v2 files.
# Empty URL = sorter off (the pipeline runs without it).
CLASSIFY_SORTER_URL=http://sorter:8000
#CLASSIFY_SORTER_TRASH_THRESHOLD=0.99747
#CLASSIFY_SORTER_TIMEOUT=120
